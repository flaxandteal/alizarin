{
  "name": "@alizarin/geo-napi",
  "version": "2.0.0-beta.4",
  "license": "AGPL-3.0-or-later",
  "description": "NAPI binding for the Alizarin geo (geojson-feature-collection) extension",
  "repository": {
    "type": "git",
    "url": "https://github.com/flaxandteal/alizarin",
    "directory": "ext/geo/napi"
  },
  "main": "register.js",
  "napi": {
    "name": "alizarin-geo-napi",
    "triples": {
      "defaults": true
    }
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "version": "napi version"
  },
  "peerDependencies": {
    "@alizarin/napi": "2.0.0-beta.4"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  },
  "optionalDependencies": {
    "@alizarin/geo-napi-win32-x64-msvc": "2.0.0-beta.4",
    "@alizarin/geo-napi-darwin-x64": "2.0.0-beta.4",
    "@alizarin/geo-napi-linux-x64-gnu": "2.0.0-beta.4"
  },
  "files": [
    "register.js",
    "index.js",
    "index.d.ts",
    "*.node"
  ]
}
